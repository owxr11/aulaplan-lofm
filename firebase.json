{
  "functions": [
    {
      "source": "apps/api",
      "codebase": "aulaplan-api",
      "runtime": "python311",
      "ignore": [
        ".venv",
        "venv",
        "__pycache__",
        "*.pyc",
        ".git"
      ]
    }
  ],
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}